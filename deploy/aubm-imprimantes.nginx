# Parc d'imprimantes AUBM : fichiers statiques et proxy vers l'API MySQL.
server {
    listen 80;
    listen [::]:80;
    server_name __SERVER_NAME__;

    root __WEB_ROOT__;
    index index.html;

    access_log /var/log/nginx/aubm-imprimantes.access.log;
    error_log /var/log/nginx/aubm-imprimantes.error.log;

    add_header X-Content-Type-Options nosniff always;
    add_header Referrer-Policy strict-origin-when-cross-origin always;

    location = /index.html {
        add_header Cache-Control "no-cache";
        add_header X-Content-Type-Options nosniff always;
        add_header Referrer-Policy strict-origin-when-cross-origin always;
    }

    location /api/ {
        proxy_pass http://127.0.0.1:__API_PORT__;
        proxy_http_version 1.1;
        proxy_set_header Host $host;
        proxy_set_header X-Forwarded-For $proxy_add_x_forwarded_for;
        proxy_set_header X-Forwarded-Proto $scheme;
        proxy_read_timeout 30s;
        add_header Cache-Control "no-store" always;
        add_header X-Content-Type-Options nosniff always;
        add_header Referrer-Policy strict-origin-when-cross-origin always;
    }

    location / {
        try_files $uri $uri/ /index.html;
    }

    location /js/ {
        add_header Cache-Control "no-cache";
    }

    location /css/ {
        add_header Cache-Control "no-cache";
    }
}
